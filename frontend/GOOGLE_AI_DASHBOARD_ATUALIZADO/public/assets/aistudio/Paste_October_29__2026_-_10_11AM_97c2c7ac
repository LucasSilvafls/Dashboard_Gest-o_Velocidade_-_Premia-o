  // Simple interactivity for the collapsible filter and view toggles
  (function() {
    const btnToggle = document.getElementById('btn-toggle-filters');
    const filtersContainer = document.getElementById('filters-container');
    const labelToggle = document.getElementById('label-toggle-filter');
    const iconToggle = document.getElementById('icon-toggle-filter');
    let isCollapsed = false;

    if (btnToggle && filtersContainer) {
      btnToggle.addEventListener('click', function() {
        isCollapsed = !isCollapsed;
        if (isCollapsed) {
          filtersContainer.classList.add('hidden');
          labelToggle.textContent = 'Expandir';
          iconToggle.style.transform = 'rotate(180deg)';
        } else {
          filtersContainer.classList.remove('hidden');
          labelToggle.textContent = 'Recolher';
          iconToggle.style.transform = 'rotate(0deg)';
        }
      });
    }

    const btnReset = document.getElementById('btn-reset-filters');
    if (btnReset) {
      btnReset.addEventListener('click', function() {
        const selects = document.querySelectorAll('#filters-container select');
        selects.forEach(s => s.selectedIndex = 0);
      });
    }

    const btnSync = document.getElementById('btn-sync');
    if (btnSync) {
      btnSync.addEventListener('click', function() {
        const icon = btnSync.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.classList.add('animate-spin');
          setTimeout(() => icon.classList.remove('animate-spin'), 1200);
        }
      });
    }

    // Toggle daily / weekly buttons
    const btnDaily = document.getElementById('toggle-daily');
    const btnWeekly = document.getElementById('toggle-weekly');
    if (btnDaily && btnWeekly) {
      btnDaily.addEventListener('click', function() {
        btnDaily.className = 'px-space-sm py-1 rounded bg-[#2ca03a] font-label-caps text-label-caps text-white font-bold shadow-sm';
        btnWeekly.className = 'px-space-sm py-1 rounded font-label-caps text-label-caps text-[#94a3b8] hover:text-white transition-colors';
      });
