        btnWeekly.className = 'px-space-sm py-1 rounded bg-[#2ca03a] font-label-caps text-label-caps text-white font-bold shadow-sm';
        btnDaily.className = 'px-space-sm py-1 rounded font-label-caps text-label-caps text-[#94a3b8] hover:text-white transition-colors';
      });
    }
  })();
